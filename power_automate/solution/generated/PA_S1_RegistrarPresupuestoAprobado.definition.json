{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    }
  },
  "triggers": {
    "When_a_file_is_created_or_modified_properties_only": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedFileItems"
        },
        "parameters": {
          "dataset": "https://sciprowall.sharepoint.com/sites/PROYECTOSPROWALL",
          "table": "8d884441-daa4-45b5-beb4-f09abdd1433a",
          "folderPath": "/Documentos compartidos/Proyectos/Presupuestos Aprobados"
        },
        "authentication": "@parameters('$authentication')"
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']"
    }
  },
  "actions": {
    "Condition_archivo_xlsx_en_inbox": {
      "type": "If",
      "expression": {
        "and": [
          {
            "endsWith": [
              "@toLower(triggerOutputs()?['body/{FilenameWithExtension}'])",
              ".xlsx"
            ]
          },
          {
            "not": {
              "startsWith": [
                "@triggerOutputs()?['body/{FilenameWithExtension}']",
                "~$"
              ]
            }
          },
          {
            "contains": [
              "@triggerOutputs()?['body/{Path}']",
              "/Proyectos/Presupuestos Aprobados/"
            ]
          }
        ]
      },
      "actions": {
        "Get_existing_queue_items": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://sciprowall.sharepoint.com/sites/PROYECTOSPROWALL",
              "table": "91e1c898-b8fb-44a9-8236-a600c6e38340",
              "$top": 200
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Filter_existing_pending_queue_items": {
          "type": "Query",
          "inputs": {
            "from": "@body('Get_existing_queue_items')?['value']",
            "where": "@and(equals(item()?['FileID'],triggerOutputs()?['body/{Identifier}']),equals(item()?['EventType']?['Value'],'presupuesto_aprobado'),or(equals(item()?['Estado']?['Value'],'Pendiente'),equals(item()?['Estado']?['Value'],'Procesando')))"
          },
          "runAfter": {
            "Get_existing_queue_items": [
              "Succeeded"
            ]
          }
        },
        "If_no_existing_pending_queue_item": {
          "type": "If",
          "expression": "@equals(length(body('Filter_existing_pending_queue_items')),0)",
          "actions": {
            "Create_item_Cola_Automatizacion_Proyectos": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem"
                },
                "parameters": {
                  "dataset": "https://sciprowall.sharepoint.com/sites/PROYECTOSPROWALL",
                  "table": "91e1c898-b8fb-44a9-8236-a600c6e38340",
                  "item/Title": "@triggerOutputs()?['body/{FilenameWithExtension}']",
                  "item/EventType/Value": "presupuesto_aprobado",
                  "item/Estado/Value": "Pendiente",
                  "item/Filename": "@triggerOutputs()?['body/{FilenameWithExtension}']",
                  "item/FileID": "@triggerOutputs()?['body/{Identifier}']",
                  "item/FolderPath": "@triggerOutputs()?['body/{Path}']",
                  "item/FileLink": "@triggerOutputs()?['body/{Link}']",
                  "item/CreatedByEmail": "@triggerOutputs()?['body/Editor/Email']",
                  "item/CreatedTime": "@triggerOutputs()?['body/Created']",
                  "item/Intentos": "0",
                  "item/Notas": "Registrado por Power Automate al crear, modificar o mover a Presupuestos Aprobados"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Filter_existing_pending_queue_items": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {}
    }
  },
  "outputs": {}
}